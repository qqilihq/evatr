{
  "name": "evatr",
  "description": "Validate foreign VAT numbers via German “Bundeszentralamt für Steuern”",
  "author": "Philipp Katz <philipp@philippkatz.de>",
  "version": "7.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qqilihq/evatr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/qqilihq/evatr.git"
  },
  "keywords": [
    "vat",
    "validation",
    "germany",
    "Bundeszentralamt für Steuern",
    "typescript"
  ],
  "scripts": {
    "test": "node --require tsx/cjs --test ./test/index.test.ts",
    "test:watch": "node --require tsx/cjs --test --watch ./test/index.test.ts",
    "lint": "eslint --ext .ts ./lib ./test",
    "build": "tsc -p tsconfig.build.json",
    "test:coverage": "c8 --reporter=html node --require tsx/cjs --test ./test/index.test.ts",
    "clean": "rimraf ./coverage ./dist",
    "preversion": "run-s clean lint test build",
    "scrape-error-codes": "tsx ./dev/scrape-error-codes.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^18",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "c8": "^10.1.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "moment-timezone": "^0.5.33",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "volta": {
    "node": "18.19.0",
    "yarn": "1.22.19"
  }
}
