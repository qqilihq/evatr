{
  "name": "evatr",
  "description": "Validate foreign VAT numbers via German “Bundeszentralamt für Steuern”",
  "author": "Philipp Katz <philipp@philippkatz.de>",
  "version": "8.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qqilihq/evatr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/qqilihq/evatr.git"
  },
  "keywords": [
    "vat",
    "validation",
    "germany",
    "Bundeszentralamt für Steuern",
    "typescript"
  ],
  "scripts": {
    "test": "node --require tsx/cjs --test ./test/index.test.ts",
    "test:watch": "node --require tsx/cjs --test --watch ./test/index.test.ts",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "test:coverage": "c8 --reporter=html node --require tsx/cjs --test ./test/index.test.ts",
    "clean": "node -e \"['./coverage', './dist'].forEach(entry => require('fs').rmSync(entry, { recursive: true, force: true }));\"",
    "preversion": "yarn clean && yarn lint && yarn test && yarn build",
    "scrape-error-codes": "tsx ./dev/scrape-error-codes.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^18",
    "c8": "^11.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "moment-timezone": "^0.5.33",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.58.1"
  },
  "engines": {
    "node": ">=18"
  },
  "volta": {
    "node": "18.19.0",
    "yarn": "1.22.19"
  }
}
